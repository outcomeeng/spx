{
  "domain": {
    "commandName": "validation"
  },
  "subcommands": {
    "typescript": { "commandName": "typescript", "alias": "ts" },
    "lint": { "commandName": "lint" },
    "circular": { "commandName": "circular" },
    "knip": { "commandName": "knip" },
    "literal": { "commandName": "literal" },
    "markdown": { "commandName": "markdown", "alias": "md" },
    "format": { "commandName": "format" },
    "all": { "commandName": "all" }
  },
  "help": {
    "longFlag": "--help",
    "pathOperand": "[paths...]",
    "literalFlags": [
      "--allowlist-existing",
      "--kind <kind>",
      "--files-with-problems",
      "--literals",
      "--verbose"
    ],
    "literalProblemKinds": ["reuse", "dupe"]
  },
  "options": {
    "scope": "--scope",
    "quiet": "--quiet",
    "json": "--json"
  },
  "diagnostics": {
    "unknownSubcommand": {
      "label": "unknown subcommand",
      "exitCode": 1
    },
    "unknownLiteralProblemKind": {
      "label": "unknown problem kind",
      "exitCode": 1
    },
    "invalidPathOperand": {
      "label": "invalid path operand",
      "reason": "escapes product directory",
      "exitCode": 1
    }
  }
}
